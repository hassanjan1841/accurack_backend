# Local development env for Accurack backend. Copy to .env: cp .env.local.example .env
# These are LOCAL-ONLY dev values (never used in production). Google/AWS are dummies so the
# app boots without real cloud creds — file upload / OAuth features won't work locally, which
# is fine for local dev and screenshots.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Local Postgres (created by scripts/setup-local.sh)
DATABASE_URL=postgresql://accurack_admin:secure_password_123@localhost:5432/accurack_master
DIRECT_URL=postgresql://accurack_admin:secure_password_123@localhost:5432/accurack_master
DB_HOST=localhost
DB_PORT=5432
DB_USER=accurack_admin
DB_PASSWORD=secure_password_123
DB_NAME=accurack_master

# Local dev secrets (any strong-ish string works locally)
JWT_SECRET=local_dev_jwt_secret_at_least_256_bits_long_for_accurack_screens_0001
JWT_REFRESH_SECRET=local_dev_refresh_secret_at_least_256_bits_long_accurack_screens_0002
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=abcdefghijklmnopqrstuvwxyz012345

# Dummies — boot-only, not functional locally
GOOGLE_CLIENT_ID=dummy.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
GMAIL_CLIENT_ID=dummy.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=dummy
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground
GMAIL_REFRESH_TOKEN=dummy
GMAIL_USER=dev@example.com
GMAIL_APP_PASSWORD=dummy
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
LOG_LEVEL=debug
ENABLE_DETAILED_LOGGING=true
NODE_OPTIONS=--max-old-space-size=768
